---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign core_urls = "/|/about/|/contact/|/privacypolicy/|/disclaimer/|/tags/|/resources/|/category/ai-security/|/category/threat-intelligence/|/category/defense/" | split: "|" %}
  {% for path in core_urls %}
  <url><loc>{{ path | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% assign seo_posts = site.posts | where_exp: "post", "post.is_generated != true" %}
  {% for post in seo_posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
