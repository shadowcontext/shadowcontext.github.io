{
  "name": "jekflix-template",
  "version": "3.1.2",
  "description": "A Jekyll theme inspired by Netflix",
  "type": "module",
  "main": "gulpfile.js",
  "homepage": "https://github.com/thiagorossener/jekflix-template.git#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thiagorossener/jekflix-template.git"
  },
  "keywords": [
    "jekyll",
    "template",
    "theme",
    "blog",
    "netlify"
  ],
  "author": "Thiago Rossener",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thiagorossener/jekflix-template/issues"
  },
  "scripts": {
    "test:threads": "node --test automation/threads/*.test.mjs",
    "lint:threads": "node --check automation/threads/threads-api.mjs && node --check automation/threads/threads-lib.mjs && node --check automation/threads/rss-feed.mjs && node --check automation/threads/publish-to-threads.mjs && node --check automation/threads/publish-rss-feed.mjs",
    "test:threads-carousel": "node --test automation/threads-carousel/*.test.mjs",
    "lint:threads-carousel": "node --check automation/threads-carousel/*.mjs",
    "format:threads-carousel": "prettier --ignore-unknown --write automation/threads-carousel .github/workflows/generate-threads-carousels.yml .github/workflows/publish-threads-carousels.yml docs/threads-carousel-automation.md .env.threads-carousel.example package.json",
    "format:threads-carousel:check": "prettier --ignore-unknown --check automation/threads-carousel .github/workflows/generate-threads-carousels.yml .github/workflows/publish-threads-carousels.yml docs/threads-carousel-automation.md .env.threads-carousel.example package.json",
    "dry-run:threads-carousel": "node automation/threads-carousel/cli.mjs prepare --dry-run true --mock-gemini"
  },
  "devDependencies": {
    "browser-sync": "^2.26.7",
    "child_process": "^1.0.2",
    "del": "^7.0.0",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-imagemin": "^8.0.0",
    "gulp-include": "^2.4.1",
    "gulp-plumber": "^1.1.0",
    "gulp-rename": "^2.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.0",
    "gulp-yaml": "^2.0.4",
    "json-sass": "^1.3.5",
    "lodash": "^4.17.21",
    "lodash.merge": "^4.6.2",
    "prettier": "^3.9.6",
    "vinyl-source-stream": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "gray-matter": "^4.0.3",
    "luxon": "^3.7.2",
    "sharp": "^0.34.5"
  }
}
